{
  "name": "dsh-expert-team",
  "description": "Expert Team (专家团) plugin for DeepSeek Harness: role-bounded expert agents, task dispatch with acceptance criteria, and unanimous cross-validation before a task is verified.",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/images",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "expert-team",
    "expert",
    "agent",
    "cross-validation",
    "专家团"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tipus0731/dsh-expert-team.git"
  },
  "homepage": "https://github.com/tipus0731/dsh-expert-team",
  "bugs": {
    "url": "https://github.com/tipus0731/dsh-expert-team/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
